systemctl stop kodi

if [ -n "${KODI_KEYBOARD_LAYOUT}" ]; then
  export XKB_DEFAULT_LAYOUT="${KODI_KEYBOARD_LAYOUT}"
fi

start-wayland-session "$@"

if [ "$(systemctl is-system-running 2>/dev/null || true)" != "stopping" ]; then
  systemctl start kodi
fi

